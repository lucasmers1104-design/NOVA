{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA",
  "version": "../package.json",
  "identifier": "dev.nova.commandcenter",
  "build": {
    "beforeDevCommand": "node scripts/build-helpers.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-helpers.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "NOVA",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#090B12"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https://i.ytimg.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://novaplugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Your Personal Command Center",
    "longDescription": "NOVA brings system monitoring, launchers, productivity and AI tools together in one local-first desktop command center.",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/nova-phonemize"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMkJDM0I4MTVCQkQ5NzkKUldSNTJic1Z1TU1yN2xPaWx4ZGFSYXo0OUU4cXZPUEREMjhCUjhqR2c5Qm5QV29XSmtpUElOV1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
