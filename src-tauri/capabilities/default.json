{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core defaults, custom window chrome, native file/folder pickers, notifications, signed self-updates, and NOVA's own commands (each validated in Rust).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "notification:default",
    "allow-system-info",
    "allow-system-snapshot",
    "allow-system-processes",
    "allow-system-network-interfaces",
    "allow-system-temperatures",
    "allow-storage-volumes",
    "allow-storage-status",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-delete",
    "allow-dashboard-layouts-list",
    "allow-dashboard-layout-save",
    "allow-dashboard-layout-delete",
    "allow-productivity-load",
    "allow-project-save",
    "allow-task-save",
    "allow-note-save",
    "allow-productivity-delete",
    "allow-ai-conversations-list",
    "allow-ai-conversation-messages",
    "allow-ai-conversation-rename",
    "allow-ai-conversation-delete",
    "allow-wallpaper-info",
    "allow-wallpaper-image",
    "allow-apps-list",
    "allow-app-icon",
    "allow-app-launch",
    "allow-app-shortcut-add",
    "allow-app-shortcut-remove",
    "allow-media-state",
    "allow-media-artwork",
    "allow-media-control",
    "allow-media-volume",
    "allow-media-volume-set",
    "allow-ai-key-status",
    "allow-ai-key-set",
    "allow-ai-key-delete",
    "allow-ai-models",
    "allow-ai-chat",
    "allow-ai-chat-cancel",
    "allow-weather-search",
    "allow-weather-forecast",
    "allow-news-fetch",
    "allow-open-url",
    "allow-files-known-folders",
    "allow-files-recent",
    "allow-files-list",
    "allow-files-search",
    "allow-files-open",
    "allow-files-reveal",
    "allow-desktop-set-close-to-tray",
    "allow-autostart-get",
    "allow-autostart-set",
    "allow-update-check",
    "allow-update-install",
    "allow-assistant-status",
    "allow-assistant-configure",
    "allow-assistant-reset-position",
    "allow-assistant-toggle",
    "allow-assistant-agent-status",
    "allow-assistant-agent-configure",
    "allow-assistant-actions",
    "allow-assistant-clear-history",
    "allow-finder-status",
    "allow-finder-pick-folder",
    "allow-finder-add-standard-folders",
    "allow-finder-remove-folder",
    "allow-finder-set-content",
    "allow-finder-reindex",
    "allow-finder-search",
    "allow-wake-status",
    "allow-wake-configure",
    "allow-wake-test",
    "allow-voice-open-settings"
  ]
}
