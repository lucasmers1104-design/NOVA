{
  "expo": {
    "name": "NOVA Companion",
    "slug": "nova-companion",
    "scheme": "novacompanion",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07070C",
    "newArchEnabled": true,
    "android": {
      "package": "dev.nova.companion",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "ACCESS_WIFI_STATE",
        "ACCESS_NETWORK_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#11152A"
      }
    },
    "ios": {
      "bundleIdentifier": "dev.nova.companion",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "NOVA Companion verbindet sich in deinem WLAN mit NOVA auf deinem PC.",
        "NSBonjourServices": [
          "_nova-companion._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSSpeechRecognitionUsageDescription": "Damit dein Handy dein Diktat in Text umwandelt.",
        "NSMicrophoneUsageDescription": "Damit du NOVA Aufträge diktieren kannst."
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "NOVA Companion nutzt die Kamera nur, um den Kopplungscode auf deinem PC zu scannen.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mit Face ID gibst du Aktionen auf deinem PC frei."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Damit du NOVA Aufträge diktieren kannst.",
          "speechRecognitionPermission": "Damit dein Handy dein Diktat in Text umwandelt."
        }
      ],
      "./plugins/android"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "65913e27-0964-46ab-a518-24144d9d83e6"
      }
    },
    "owner": "lucasx77",
    "icon": "./assets/icon.png"
  }
}
