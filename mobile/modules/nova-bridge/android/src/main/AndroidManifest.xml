<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Hand a downloaded update to Android's installer (the user confirms there). -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Answer or end a call from Nova Island when the phone app offers no buttons of its own (asked at runtime). -->
  <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

  <!--
    Android 11+ hides other apps from this one. To show a notification on the PC with its
    app's name and icon ("WhatsApp", not "com.whatsapp"), the apps on the home screen have
    to be visible. This is not QUERY_ALL_PACKAGES: only apps with a launcher icon, and only
    their label and icon are read.
  -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <!-- Android binds it only after the user allowed notification access in the system settings. -->
    <service
      android:name="dev.nova.bridge.NovaNotificationListener"
      android:label="NOVA Companion"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
