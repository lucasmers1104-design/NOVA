# Dependencies
node_modules/

# Frontend build output
dist/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/schemas/

# Local environment and secrets — never commit API keys
.env
.env.*
!.env.example

# Editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.log
Thumbs.db
.DS_Store

# Test coverage
coverage/

# Plugin packages never belong here: private ones live in nova-private, keys outside any repository.
*.novaplugin
# ...except the published ones NOVA offers in Plugins → Available.
!releases/plugins/*.novaplugin
*.key

# Built by scripts/build-helpers.mjs
src-tauri/binaries/
tools/*/target/

# Private: the Discord relay is its own private repository (nova-relay), the invite plugin and
# signed packages for hand installs stay on the owner's PC, work orders stay local.
server/relay/
plugins/relay-invite/
dist-plugins/
docs/prompts/

# A copy of ../packages/companion-protocol, only during a cloud build (scripts/eas-build.mjs).
mobile/vendor/
