# What `eas build` uploads from this repository: only the phone app and the shared
# package. (An .easignore replaces .gitignore for the upload, so both are listed.)
# Desktop paths start with "/": without it, "src/" would also drop mobile/src and
# packages/companion-protocol/src.
node_modules/
dist/
.expo/
.env
.env.*
*.novaplugin
*.key

/releases/
/src/
/src-tauri/
/tools/
/examples/
/scripts/
/public/
/assets/
/mobile/android/
/mobile/ios/
